{
  "name": "@do-better/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "bun --bun drizzle-kit push",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate:deploy": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:start": "bun run db:migrate",
    "db:watch": "bun run db:studio",
    "db:stop": "bun -e 'console.log(\"SQLite is embedded; no database service to stop. Data files are preserved.\")'",
    "db:down": "bun -e 'console.log(\"SQLite is embedded; no database service to stop. Data files are preserved.\")'"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@do-better/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
