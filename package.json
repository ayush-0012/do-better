{
  "name": "do-better",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/cli/ui",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@do-better/web",
    "build": "turbo run build",
    "build:cli": "turbo run build -F do-better-cli",
    "build:web": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/cli start",
    "check-types": "turbo run check-types",
    "db:push": "turbo run db:push -F @do-better/db --",
    "db:studio": "turbo run db:studio -F @do-better/db --",
    "db:generate": "turbo run db:generate -F @do-better/db --",
    "db:migrate": "turbo run db:migrate -F @do-better/db --",
    "db:start": "turbo run db:start -F @do-better/db --",
    "db:watch": "turbo run db:watch -F @do-better/db --",
    "db:stop": "turbo run db:stop -F @do-better/db --",
    "db:down": "turbo run db:down -F @do-better/db --",
    "dev:cli": "bun run build:cli && bun run --cwd apps/cli start"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@do-better/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
